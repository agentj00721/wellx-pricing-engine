# Wellx Pricing Engine — environment variables
# Copy this to .env.local and fill in the values from your Supabase project.

# Found at: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only. NEVER expose to the browser. Used by team-side API routes.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
